# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ...but the Gradle wrapper jar MUST be committed so ./gradlew works on a clean
# checkout. Without this exception the blanket *.jar above excluded it, which
# broke command-line builds for everyone.
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Gradle
.gradle/
build/

# Android Studio
.idea/
*.iml
*.hprof

# Kotlin/Compose
captures/

# Native build scaffolding (no first-party C/C++ sources in this project)
.cxx/

# Room exported schemas are generated build output
app/schemas/

# Cleanup audit workspace (archive of removed code, kept until final approval)
_cleanup_archive/

